{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["app/**/*.ts", "games/**/*.ts", "tools/**/*.ts"],
  "exclude": ["**/dist", "**/vendor", "**/story-ui", "**/tests", "**/dev"]
}
